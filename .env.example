PORT=5000

# Set to a real Mongo connection string to use MongoDB/Mongoose.
# Leave empty to use the built-in JSON file store (./data/db.json).
MONGO_URI=

# Local persistence location used by the JSON store.
DB_FILE=./data/db.json

UPLOAD_DIR=./uploads
IMG_MAX_MB=5

# AI toggles. Requires heavy optional runtimes to be installed first.
EMBEDDINGS_ENABLED=false
DETECTION_ENABLED=false
# Absolute or server-relative path to a YOLOv8 .onnx model to enable real detection.
DETECTION_MODEL=./models/yolov8n.onnx

# Admin login credentials (used by the /api/auth endpoints).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me